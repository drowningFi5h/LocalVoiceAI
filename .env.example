# Local generation: ollama or lmstudio (both stay on this machine).
LVA_LOCAL_BACKEND=ollama
LVA_LMSTUDIO_URL=http://localhost:1234/v1
LVA_LMSTUDIO_MODEL=qwen/qwen3-vl-4b
LVA_LMSTUDIO_API_KEY=
LVA_DATA_DIR=./data
LVA_OLLAMA_URL=http://127.0.0.1:11434
LVA_OLLAMA_MODEL=qwen3:4b
# Cloud is only used when explicitly selected in the UI.
# Gemini: backend=gemini, model=gemini-flash-latest, key from Google AI Studio.
LVA_CLOUD_BACKEND=openai
LVA_CLOUD_MODEL=gpt-4.1-mini
LVA_CLOUD_API_KEY=
LVA_CLOUD_BASE_URL=https://api.openai.com/v1
LVA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LVA_WHISPER_MODEL=base.en
LVA_WHISPER_DEVICE=cpu
LVA_WHISPER_COMPUTE_TYPE=int8
LVA_KOKORO_VOICE=af_heart
LVA_OFFLINE=false
